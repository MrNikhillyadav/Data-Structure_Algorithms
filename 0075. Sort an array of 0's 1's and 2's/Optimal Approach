// Dutch National flag algorithm

// Optimal solution:
// void f(x) mtlab given arr me hi changes krne hote h.

class Solution {
public:
    void sortColors(vector<int>& arr) {
        int n = arr.size();
        int low =0 , mid = 0 ,high = n-1;

        while(mid <= high){
            if(arr[mid] == 0){
                swap(arr[low], arr[mid]);
                mid++;
                low++;
            }
            else if(arr[mid] == 1){
                mid++;
            }
            else{
                swap(arr[mid], arr[high]);
                high --;
            }
        }
    }
        
};

/*
    Core Idea (3 Regions)

    - We divide array into 4 parts:

        [ 0s | 1s | unknown | 2s ]
          ↑      ↑      ↑      ↑
          low    mid           high

    Deep Intuition (What interviewer checks)

   - You maintain an invariant:
        [0 → low-1]    → all 0s 
        [low → mid-1]  → all 1s 
        [mid → high]   → unknown 
        [high+1 → end] → all 2s 
*/
